# ---------- Server ----------
APP_SECRET_KEY=change-this-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- LLM Provider (OpenAI-compatible) ----------
# Works with OpenAI, Groq, OpenRouter, Together AI, Google Gemini (OpenAI-compat endpoint), etc.
# If LLM_API_KEY is left empty, StudySphere AI automatically falls back to an
# extractive "smart summary" mode and an offline hashing-vectorizer for embeddings,
# so the app is still fully usable without a paid key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# Used only when LLM_API_KEY above is set (via the same OpenAI-compatible /embeddings
# endpoint). With no key, StudySphere AI automatically uses a lightweight, dependency-free
# hashing-based embedding so search still works fully offline.
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Database ----------
# Local development (default): a zero-setup SQLite file.
DATABASE_URL=sqlite:///./studysphere.db
# Production / serverless (Vercel, Render, etc.): point this at a managed Postgres
# instance instead - e.g. Vercel Postgres, Neon, or Supabase - no code changes needed:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins. Keep "*" for local development.
# In production, set this to your deployed frontend URL, e.g.:
# FRONTEND_ORIGINS=https://studysphere-ai.vercel.app
FRONTEND_ORIGINS=*
